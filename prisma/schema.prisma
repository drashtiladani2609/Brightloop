// datasource is sqlite for local demo - swap provider to postgresql and set DATABASE_URL to a postgres url for prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("CUSTOMER")
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer?
  createdSubs    Subscription[]   @relation("SubscriptionCreator")
  events         SubscriptionEvent[]
  payments       Payment[]
  resetTokens    PasswordResetToken[]

  @@index([role])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  contactName String
  email       String    @unique
  phone       String?
  addressLine String?
  city        String?
  country     String?
  taxId       String?
  notes       String?
  active      Boolean   @default(true)
  userId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices    Invoice[]

  @@index([name])
  @@index([createdAt])
}

model Product {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("Software")
  category   String   @default("General")
  salesPrice Float    @default(0)
  costPrice  Float    @default(0)
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  variants   ProductVariant[]
  lines      SubscriptionLine[]
  invoiceLines InvoiceLine[]
  taxes      TaxRule[]
  discounts  DiscountRule[]
  templateLines TemplateLine[]

  @@index([active])
  @@index([category])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  attribute  String
  value      String
  priceExtra Float   @default(0)
  sku        String?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  subLines   SubscriptionLine[]
  invoiceLines InvoiceLine[]
  templateLines TemplateLine[]

  @@index([productId])
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float    @default(0)
  period          String   @default("MONTHLY")
  minQuantity     Int      @default(1)
  availableFrom   DateTime?
  availableTo     DateTime?
  autoCloseOnEnd  Boolean  @default(false)
  closableEarly   Boolean  @default(true)
  pausable        Boolean  @default(true)
  renewable       Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   Subscription[]
  templates       QuotationTemplate[]

  @@index([active])
  @@index([period])
}

model QuotationTemplate {
  id          String   @id @default(cuid())
  name        String
  validityDays Int     @default(30)
  planId      String
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  plan        Plan     @relation(fields: [planId], references: [id])
  lines       TemplateLine[]

  @@index([planId])
}

model TemplateLine {
  id         String  @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int     @default(1)
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([productId])
}

model TaxRule {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  scope     String   @default("ALL")
  category  String?
  productId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([productId])
}

model DiscountRule {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("PERCENTAGE")
  value      Float
  scope      String   @default("SUBSCRIPTION")
  productId  String?
  minAmount  Float?
  minQuantity Int?
  startDate  DateTime?
  endDate    DateTime?
  usageLimit Int?
  usedCount  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  usages     DiscountUsage[]

  @@index([active])
  @@index([scope])
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  invoiceId  String
  amount     Float
  createdAt  DateTime @default(now())
  discount   DiscountRule @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
  @@index([invoiceId])
}

model Subscription {
  id                     String    @id @default(cuid())
  number                 String    @unique
  customerId             String
  planId                 String
  status                 String    @default("DRAFT")
  startDate              DateTime
  expiryDate             DateTime
  paymentTerms           String    @default("IMMEDIATE")
  quotationValidityDays  Int       @default(30)
  quotationValidUntil    DateTime?
  currency               String    @default("USD")
  subtotal               Float     @default(0)
  discountTotal          Float     @default(0)
  taxTotal               Float     @default(0)
  total                  Float     @default(0)
  nextBillingDate        DateTime?
  lastBilledAt           DateTime?
  notes                  String?
  pausedAt               DateTime?
  closedAt               DateTime?
  resumeStatus           String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  customer               Customer  @relation(fields: [customerId], references: [id])
  plan                   Plan      @relation(fields: [planId], references: [id])
  createdBy              User?     @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines                  SubscriptionLine[]
  invoices               Invoice[]
  events                 SubscriptionEvent[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([createdAt])
  @@index([status, nextBillingDate])
}

model SubscriptionLine {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int     @default(1)
  unitPrice      Float
  taxRuleId      String?
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  discountAmount Float   @default(0)
  lineAmount     Float
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  fromStatus     String?
  toStatus       String
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([createdAt])
}

model Invoice {
  id                 String    @id @default(cuid())
  number             String    @unique
  subscriptionId     String
  customerId         String
  status             String    @default("DRAFT")
  issueDate          DateTime
  dueDate            DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Float     @default(0)
  discountTotal      Float     @default(0)
  taxTotal           Float     @default(0)
  total              Float     @default(0)
  amountPaid         Float     @default(0)
  notes              String?
  sentAt             DateTime?
  confirmedAt        DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer           Customer  @relation(fields: [customerId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]
  emails             EmailLog[]

  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([createdAt])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  kind        String  @default("PRODUCT")
  description String
  productId   String?
  variantId   String?
  quantity    Int     @default(1)
  unitPrice   Float
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  lineAmount  Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  method       String
  amount       Float
  paidAt       DateTime
  status       String   @default("SETTLED")
  reference    String?
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([method])
  @@index([paidAt])
  @@index([status])
}

model BillingRun {
  id          String    @id @default(cuid())
  trigger     String    @default("CRON")
  status      String    @default("SUCCESS")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int       @default(0)
  created     Int       @default(0)
  skipped     Int       @default(0)
  invoicesOk  Int       @default(0)
  errors      Int       @default(0)
  message     String?
  actorId     String?
  createdAt   DateTime  @default(now())

  @@index([startedAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  type      String   @default("INVOICE")
  invoiceId String?
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([invoiceId])
}

model Counter {
  key   String @id
  value Int    @default(0)
}
